{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://rendevouz-8sfp.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://rendevouz-8sfp.onrender.com/uploads/$1"
    },
    {
      "source": "/data/uploads/(.*)",
      "destination": "https://rendevouz-8sfp.onrender.com/data/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
